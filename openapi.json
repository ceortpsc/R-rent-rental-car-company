{
  "openapi": "3.1.0",
  "info": {
    "title": "R-Rent API",
    "version": "0.6.0",
    "description": "Provider-gated rental APIs; public quote active, transactional routes closed until evidence gates pass."
  },
  "servers": [
    {
      "url": "https://rtpscrentalcars.com"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health and safety-gate status",
        "responses": {
          "200": {
            "description": "Function online"
          }
        }
      }
    },
    "/api/v1/readiness": {
      "get": {
        "summary": "Configured features without verifying providers",
        "responses": {
          "200": {
            "description": "Capabilities and blockers"
          }
        }
      }
    },
    "/api/v1/vehicles": {
      "get": {
        "summary": "Redacted public vehicle catalog",
        "responses": {
          "200": {
            "description": "Vehicles"
          }
        }
      }
    },
    "/api/v1/quote": {
      "post": {
        "summary": "Provisional non-binding quote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "vehicle_id",
                  "pickup_at",
                  "return_at"
                ],
                "properties": {
                  "vehicle_id": {
                    "type": "string"
                  },
                  "pickup_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "return_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provisional quote"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/v1/applications": {
      "post": {
        "summary": "Authenticated DRAFT application, gated",
        "responses": {
          "201": {
            "description": "Draft record"
          },
          "503": {
            "description": "Not configured"
          }
        }
      }
    },
    "/api/v1/documents": {
      "post": {
        "summary": "Document intent metadata only, no unsafe upload URLs",
        "responses": {
          "202": {
            "description": "Pending secure storage"
          },
          "503": {
            "description": "Not enabled"
          }
        }
      }
    },
    "/api/v1/agreements": {
      "get": {
        "summary": "Agreement template registry",
        "responses": {
          "200": {
            "description": "Drafts"
          }
        }
      },
      "post": {
        "summary": "Execution blocked until e-sign validated",
        "responses": {
          "503": {
            "description": "Not enabled"
          }
        }
      }
    },
    "/api/v1/ai-assist": {
      "post": {
        "summary": "Auth-scoped rule engine, no autonomous approval",
        "responses": {
          "200": {
            "description": "Review flags"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/api/v1/payments/stripe": {
      "post": {
        "summary": "Stripe checkout only after final invoice adapter",
        "responses": {
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/api/v1/payments/paypal": {
      "post": {
        "summary": "PayPal checkout only after final invoice adapter",
        "responses": {
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/api/v1/webhooks/stripe": {
      "post": {
        "summary": "Signature check, durable ledger required",
        "responses": {
          "401": {
            "description": "Invalid signature"
          },
          "503": {
            "description": "Durable webhook inbox not ready"
          }
        }
      }
    },
    "/api/v1/webhooks/paypal": {
      "post": {
        "summary": "Provider verification, durable ledger required",
        "responses": {
          "401": {
            "description": "Invalid signature"
          },
          "503": {
            "description": "Durable webhook inbox not ready"
          }
        }
      }
    },
    "/api/v1/admin/release": {
      "post": {
        "summary": "Vehicle handoff requires approved gates",
        "responses": {
          "503": {
            "description": "Release locked"
          }
        }
      }
    },
    "/api/v1/envelopes": {
      "get": {
        "summary": "R-Rent Sign template registry and operational readiness",
        "responses": {
          "200": {
            "description": "Unsigned signing templates"
          }
        }
      },
      "post": {
        "summary": "MFA-only server-side envelope draft preparation or securely blocked issue",
        "responses": {
          "201": {
            "description": "Draft created; not delivered or signed"
          },
          "503": {
            "description": "Signing integration unavailable"
          }
        }
      }
    },
    "/api/v1/launch": {
      "get": {
        "summary": "Read-only source and independent-evidence launch gate assessment (not certification)",
        "tags": [
          "Governance",
          "Readiness"
        ],
        "responses": {
          "200": {
            "description": "17-module source and independently gated dependency registry, no secrets or customer data"
          },
          "405": {
            "description": "Method denied"
          }
        }
      }
    },
    "/api/v1/manage": {
      "get": {
        "summary": "Management availability, own session or authorized tenant access lists",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "status",
                "session",
                "members",
                "changes",
                "audit"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public-safe status or server-authorized management data; never provider tokens"
          },
          "401": {
            "description": "Invalid or expired session"
          },
          "403": {
            "description": "MFA or explicit role permission missing"
          },
          "503": {
            "description": "Management configuration, release evidence or audit unavailable"
          }
        }
      },
      "post": {
        "summary": "Management authentication, MFA, account controls and independently approved access changes",
        "description": "Exact configured HTTPS Origin, JSON and X-RRent-Action: 1 required. Payload fields vary by action; see docs/MANAGEMENT_ACCESS.md. No role is granted by login, an email string or a browser role assertion. All consequential rental actions remain gated.",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "login",
                "confirm",
                "request-code",
                "verify-code",
                "refresh",
                "logout",
                "mfa-enroll",
                "mfa-verify",
                "accept-invitation",
                "password",
                "propose",
                "approve",
                "send-invitation",
                "revoke-invitation",
                "suspend"
              ]
            }
          },
          {
            "name": "X-RRent-Action",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "maxProperties": 7
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action completed within its management-only scope"
          },
          "201": {
            "description": "Change proposed; independent approval still required"
          },
          "202": {
            "description": "Generic email sign-in request response"
          },
          "401": {
            "description": "Identity or bound session denied"
          },
          "403": {
            "description": "MFA, permission or independent approval missing"
          },
          "409": {
            "description": "Stale change, delivery claim or state conflict"
          },
          "422": {
            "description": "Invalid fields or input"
          },
          "429": {
            "description": "Shared database/provider rate limit"
          },
          "503": {
            "description": "Configuration, release, provider, database or audit unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ManagementCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-rr_session",
        "description": "Opaque host-only HttpOnly management session, also bound to provider access token and live Auth session."
      }
    }
  }
}
