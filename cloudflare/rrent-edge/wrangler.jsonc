{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rrent-access-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "RR_ENVIRONMENT": "production",
    "RR_PRIVATE_ACTIONS_ENABLED": "false"
  },
  "env": {
    "staging": {
      "name": "rrent-access-edge-staging",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": false
      },
      "vars": {
        "RR_ENVIRONMENT": "staging",
        "RR_PRIVATE_ACTIONS_ENABLED": "false"
      }
    }
  }
}
