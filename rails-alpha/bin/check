#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."
bundle check
RAILS_ENV=test bin/rails db:prepare
bin/rails test
bin/rails zeitwerk:check
bundle exec ruby script/smoke_alpha.rb
if RAILS_ENV=staging bin/rails runner 'abort "Unexpected staging boot"' 2>&1 | grep -q 'Remote staging is gated'; then
  echo "Staging boot gate: OK"
else
  echo "Missing staging boot gate" >&2
  exit 1
fi
if RAILS_ENV=production bin/rails runner 'abort "Unexpected production boot"' 2>&1 | grep -q 'Production is disabled'; then
  echo "Production boot gate: OK"
else
  echo "Missing production boot gate" >&2
  exit 1
fi
