<% content_for :title, "Rental Request" %>
<div class="frame section page"><p class="eyebrow">Request status</p><h1>Rental request.</h1><section class="card"><h2>Reference <%= @booking.reference %></h2><dl class="record"><dt>Recorded status</dt><dd><%= @booking.status.to_s.humanize %></dd><dt>Recorded rental total</dt><dd><%= number_to_currency(@booking.total_cents.to_i / 100.0) %></dd><dt>Recorded deposit</dt><dd><%= number_to_currency(@booking.deposit_cents.to_i / 100.0) %></dd></dl><p class="notice">This record does not establish payment, insurance or vehicle release. Wait for separate written confirmation and pickup instructions before relying on the arrangement.</p></section><div class="actions"><%= link_to "Open inquiry inbox", receipt_notifications_path, class: "text-link" %><a href="/programs" class="text-link">Review the rental process →</a></div></div>
