<% content_for :title, "Work Queue" %>
<div class="frame section page"><p class="eyebrow">Staff workspace · Workflow</p><h1>Work queue.</h1><p class="lead">Track open and completed internal actions. Completing an action does not change rental approval, send a message or execute a payment.</p>
<nav class="jump-nav" aria-label="Queue status"><a href="/work-queue?status=open" <%= 'aria-current=page' if @status == 'open' %>>Open actions</a><a href="/work-queue?status=completed" <%= 'aria-current=page' if @status == 'completed' %>>Completed actions</a></nav>
<section class="section tight"><h2><%= @status.to_s.humanize %> actions</h2><% if @actions.blank? %><p class="empty">No actions in this view.</p><% else %>
<div class="table-wrap" tabindex="0" role="region" aria-label="Workflow actions table"><table><thead><tr><th scope="col">Action</th><th scope="col">Related record</th><th scope="col">Completion</th><th scope="col">Available actions</th></tr></thead><tbody>
<% @actions.each do |action| %><tr><th scope="row"><%= action.action_code.to_s.humanize %><small>Queue item #<%= action.id %></small></th><td><%= action.subject_type.to_s.humanize %> #<%= action.subject_id %></td><td><%= action.completed_at ? action.completed_at.strftime("%b %-d, %Y %l:%M %p") : "Open" %></td><td><% unless action.completed_at %><%= button_to "Mark complete", "/work-queue/#{action.id}/complete", method: :post, class: "button outline", aria: { label: "Mark queue item #{action.id} complete" } %><% else %><span class="muted">No actions available</span><% end %></td></tr><% end %>
</tbody></table></div><% end %></section></div>
